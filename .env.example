APP_ENV=development
APP_TIMEZONE=America/Chicago
APPROVAL_TIMEOUT_MIN=10          # minutes before the one approval reminder SMS; the task keeps waiting after it
DATABASE_URL=sqlite:///./lifeline.db
PUBLIC_BASE_URL=            # ngrok https URL for webhooks and the LLM proxy
LLM_PROXY_SECRET=           # shared with the ElevenLabs agent config
DASHBOARD_SESSION_SECRET=   # signs the lifeline_session cookie; random per process in development when empty
NVIDIA_API_KEY=
NEMOTRON_LIGHTNING_ID=nvidia/nemotron-3.5-lightning-30b-a3b   # build.nvidia.com, verified live 2026-11-21 (#52); call with enable_thinking=false
NEMOTRON_SUPER_ID=nvidia/nemotron-3.5-super-vl-120b-a12b      # build.nvidia.com, verified live 2026-11-21 (#52)
OLLAMA_BASE_URL=http://localhost:11434
NEMOTRON_NANO_TAG=nemotron-3-nano:4b-q4_K_M                   # 4-bit GGUF tag in the Ollama library; ollama pull it (#52)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=        # agent created per integrations/elevenlabs_agent_prompt.md
ELEVENLABS_PHONE_NUMBER_ID= # imported Twilio number, from the agent's phone numbers page
ELEVENLABS_WEBHOOK_SECRET=  # shown once when the post-call webhook is created; verifies ElevenLabs-Signature. Required in VOICE_MODE=mock too: the mock receptionist signs its post-call deliveries with it, and the webhook is 503 without it
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=       # one test account
GOOGLE_MAPS_API_KEY=        # Places + Distance Matrix
DEMO_PHONE_ALLOWLIST=       # comma-separated teammate numbers, E.164
DEMO_VOICE_TARGET=          # one allowlisted teammate recipient; required for live voice
VOICE_MODE=mock             # mock | live
PLACES_MODE=fixture         # fixture | live
CALENDAR_MODE=mock          # mock | live
SMS_MODE=mock               # mock | live
TRANSPORT_MODE=fixture
LIVE_STREAM_MODE=sse        # sse | poll
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_SRC=  # public Google Calendar iframe src (frontend /calendar)
NEXT_PUBLIC_LIVE_STREAM_MODE=sse
